;; Wallpaper picker.
;;
;; This runs as its own eww instance, separate from ~/.config/eww. Eww recreates
;; every window in an instance when its stylesheet changes, which threw this list
;; back to the top each time a wallpaper was picked. Keeping the picker in its own
;; instance lets the main widgets recolor instantly while this list stays put.

(defpoll wallpapers :interval "30s" :initial "[]" "~/.config/eww/scripts/get-wallpapers.sh")

;; The panel colour comes in as a variable rather than from the stylesheet, because
;; `eww update` repaints without rebuilding the window. update-color.sh pushes the
;; new colour on every wallpaper change; the poll covers startup and reloads, which
;; reset variables back to their initial value.
(defpoll panel-bg :interval "1h" :initial "#1e1e2e" "~/.config/eww/scripts/get-panel-bg.sh")

(defwidget image-list []
  (box :class "scroll-container" 
        :vexpand "true"
        :hexpand "false"
        :width 300;
  (scroll :vscroll "true"
          :vexpand "true"
          (box :orientation "vertical"
               (for wallpaper in wallpapers
                 (eventbox  :class "image-container"
                            :onclick "~/.config/eww/scripts/change-wallpaper.sh ${wallpaper}"
                            (box  :class "image-list-preview"
                                  :width 300;
                                  :height 200;
                                  :orientation "vertical"
                                  :style "background-image: url('/home/ping/.config/wallpapers/preview-${wallpaper}.jpg');")))))))

(defwidget win []
  (box :class "window"
       :style "background-color: ${panel-bg};"
       :vexpand "false"
       :hexpand "false"
       :orientation "vertical"
       (image-list)))

(defwindow wallpaper
           :monitor 0
           :geometry (geometry  :x "64" 
                                :y "10" 
                                :width "310px"
                                :height "90%"
                                :anchor "center left")
           :stacking "overlay"
           :exclusive "false"
           ;; Clicks and scroll still work on the picker. Keyboard stays with
           ;; whatever you are using, same as Super+C.
           :focusable "none"
(win))
