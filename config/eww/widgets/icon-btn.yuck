;; Icon-only control. A GTK button with a filling, centered label so the
;; glyph sits in the middle of the tile. Overlay/eventbox collapsed these
;; to slivers because they ignore min-width.
(defwidget icon-btn [class tooltip onclick icon hexpand vexpand]
  (button :class "icon-btn ${class}"
          :tooltip tooltip
          :onclick onclick
          :hexpand hexpand
          :vexpand vexpand
          :halign "fill"
          :valign "fill"
    (label :class "icon-glyph"
           :halign "fill"
           :valign "fill"
           :hexpand true
           :vexpand true
           :xalign 0.5
           :yalign 0.5
           :text icon)))
