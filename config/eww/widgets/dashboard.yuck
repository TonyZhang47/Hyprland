;; Dashboard overlay (Super+C). Replaces the left bar.

(defwidget dash-clock []
  (box :class "dash-card dash-clock"
       :orientation "vertical"
       :space-evenly false
       :halign "fill"
       :hexpand true
       :vexpand true
    (label :class "dash-clock-time" :halign "start" :text {panel-clock.hms})
    (label :class "dash-clock-day" :halign "start" :text {panel-clock.day})
    (label :class "dash-clock-date" :halign "start" :text {panel-clock.date})
    (box :class "dash-uptime-inline"
         :orientation "horizontal"
         :space-evenly false
         :spacing 8
         :valign "end"
         :vexpand true
      (label :class "dash-uptime-icon" :text "󰔛")
      (label :class "dash-uptime-h" :text "${panel-uptime.hours}h ${panel-uptime.mins}m"))))

(defwidget dash-weather []
  (eventbox :cursor "pointer"
            :tooltip "Baltimore forecast"
            :onclick "~/.config/eww/scripts/open-weather.sh"
            :hexpand true
            :vexpand true
    (box :class "dash-card dash-weather"
         :orientation "vertical"
         :space-evenly false
         :hexpand true
         :vexpand true
      (box :orientation "horizontal" :space-evenly false
        (label :class "dash-weather-icon" :text {panel-weather.icon})
        (label :class "dash-weather-temp" :hexpand true :halign "end" :text {panel-weather.temp}))
      (label :class "dash-weather-city" :halign "start" :text {panel-weather.city})
      (label :class "dash-weather-text" :halign "start" :truncate true :limit-width 22 :text {panel-weather.text})
      (label :class "dash-weather-c" :halign "start" :vexpand true :valign "end" :text {panel-weather.temp_c}))))

(defwidget dash-power []
  (box :class "dash-card dash-power"
       :orientation "vertical"
       :space-evenly true
       :spacing 8
       :vexpand true
    (box :orientation "horizontal" :space-evenly true :spacing 8 :vexpand true
      (button :class "dash-power-btn dash-power-lock" :vexpand true :hexpand true
              :tooltip "Lock"
              :onclick "~/.config/eww/scripts/lock.sh &"
        "")
      (button :class "dash-power-btn dash-power-sleep" :vexpand true :hexpand true
              :tooltip "Sleep"
              :onclick "systemctl suspend"
        "󰒲"))
    (box :orientation "horizontal" :space-evenly true :spacing 8 :vexpand true
      (button :class "dash-power-btn dash-power-reboot" :vexpand true :hexpand true
              :tooltip "Reboot"
              :onclick "systemctl reboot"
        "󰜉")
      (button :class "dash-power-btn dash-power-off" :vexpand true :hexpand true
              :tooltip "Shut down"
              :onclick "systemctl poweroff"
        "󰐥"))))

(defwidget dash-workspaces []
  (eventbox :onscroll "~/.config/eww/scripts/bar-workspace.sh scroll {}"
    (box :class "dash-card dash-workspaces"
         :orientation "horizontal"
         :space-evenly true
         :spacing 4
         :halign "fill"
         :hexpand true
      (for ws in {bar-ws.list}
        (button :class "dash-ws ${ws.occupied ? "occupied" : "empty"} ${bar-ws.active == ws.id ? "active" : ""}"
                :onclick "~/.config/eww/scripts/bar-workspace.sh ${ws.id}"
                :tooltip "Super+${ws.label}"
          "${ws.label}")))))

(defwidget dash-folders []
  (box :class "dash-card dash-folders"
       :orientation "vertical"
       :space-evenly true
       :spacing 2
       :vexpand true
    (button :class "dash-folder" :halign "start" :onclick "~/.config/eww/scripts/open.sh nemo /home/ping/Documents" "󰈙  Documents")
    (button :class "dash-folder" :halign "start" :onclick "~/.config/eww/scripts/open.sh nemo /home/ping/Downloads" "󰇚  Downloads")
    (button :class "dash-folder" :halign "start" :onclick "~/.config/eww/scripts/open.sh nemo /home/ping/Music" "󰝚  Music")
    (button :class "dash-folder" :halign "start" :onclick "~/.config/eww/scripts/open.sh nemo /home/ping/Pictures" "󰈔  Pictures")
    (button :class "dash-folder" :halign "start" :onclick "~/.config/eww/scripts/open.sh nemo /home/ping/.config" "  ~/.config")
    (button :class "dash-folder" :halign "start" :onclick "~/.config/eww/scripts/open.sh nemo /home/ping/.local" "󰉋  ~/.local")))

(defwidget dash-top []
  (box :class "dash-top"
       :orientation "horizontal"
       :space-evenly false
       :spacing 10
       :halign "fill"
       :valign "fill"
    (dash-clock)
    (dash-weather)
    (dash-power)))

(defwidget dash-mid []
  (box :class "dash-mid"
       :orientation "horizontal"
       :space-evenly "false"
       :spacing 10
       :halign "fill"
       :valign "fill"
    (box :class "dash-mid-col" :hexpand "true" :vexpand "true" :valign "fill" (controls))
    (box :class "dash-mid-col" :hexpand "true" :vexpand "true" :valign "fill" (music-widget))))

(defwidget dash-bottom []
  (box :class "dash-bottom"
       :orientation "horizontal"
       :space-evenly false
       :spacing 10
       :halign "fill"
       :valign "fill"
    (dash-folders)
    (box :class "dash-mid-col" :hexpand true :vexpand true (resources))))

(defwidget control-center-widget []
  (box :class "control-center"
       :orientation "vertical"
       :space-evenly false
       :spacing 10
    (dash-top)
    (dash-workspaces)
    (dash-mid)
    (dash-bottom)
    (calendar-widget)))
