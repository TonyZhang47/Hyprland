;; Compact horizontal meters. The old vertical tubes stretched with the
;; card and left the labels floating at the top.

(defwidget meter [name value unit tooltip]
  (box :class "meter"
       :tooltip tooltip
       :orientation "horizontal"
       :space-evenly false
       :spacing 10
       :halign "fill"
       :valign "center"
       :hexpand true
       :vexpand true
    (label :class "meter-name"
           :halign "start"
           :valign "center"
           :hexpand false
           :text name)
    (progress :class "meter-bar meter-${name}"
              :valign "center"
              :vexpand false
              :hexpand true
              :value value)
    (label :class "meter-val"
           :halign "end"
           :valign "center"
           :hexpand false
           :text "${value}${unit}")))

(defwidget resources []
  (box :class "resources"
       :orientation "vertical"
       :space-evenly true
       :spacing 8
       :halign "fill"
       :hexpand true
       :vexpand true
    (meter :name "CPU"  :value current-cpu         :unit "%"  :tooltip "CPU usage: ${current-cpu}%")
    (meter :name "TEMP" :value current-temperature :unit "°"  :tooltip "CPU temperature: ${current-temperature}°C")
    (meter :name "MEM"  :value current-memory      :unit "%"  :tooltip "${current-memory-detail} free")
    (meter :name "DSK"  :value current-disk        :unit "%"  :tooltip "${current-disk-detail} free")
    (meter :name "BAT"  :value current-battery     :unit "%"  :tooltip time-left)))
