;; Super+H settings popup. Values persist in ~/.config/hypr/user-settings.json

(defwidget settings-widget []
  (box :class "settings-panel"
       :orientation "vertical"
       :space-evenly false
       :spacing 12
    (label :class "settings-title" :halign "start" :text "Settings")
    (label :class "settings-hint" :halign "start" :text "Saved automatically. Super+H closes.")
    (box :class "settings-row" :orientation "vertical" :space-evenly false :spacing 4 :halign "fill" :hexpand true
      (box :orientation "horizontal" :space-evenly false :halign "fill"
        (label :class "settings-name" :halign "start" :hexpand true :text "Cursor sensitivity")
        (label :class "settings-value" :halign "end" :text {user-settings.sensitivity_label}))
      (scale :class "settings-scale" :hexpand true
             :value {user-settings.sensitivity_i} :min 0 :max 200
             :onchange "~/.config/eww/scripts/set-user-setting.py sensitivity_i {}"))
    (box :class "settings-row" :orientation "vertical" :space-evenly false :spacing 4 :halign "fill" :hexpand true
      (box :orientation "horizontal" :space-evenly false :halign "fill"
        (label :class "settings-name" :halign "start" :hexpand true :text "Touchpad scroll")
        (label :class "settings-value" :halign "end" :text {user-settings.scroll_label}))
      (scale :class "settings-scale" :hexpand true
             :value {user-settings.scroll_i} :min 0 :max 100
             :onchange "~/.config/eww/scripts/set-user-setting.py scroll_i {}"))
    (box :class "settings-row" :orientation "vertical" :space-evenly false :spacing 4 :halign "fill" :hexpand true
      (box :orientation "horizontal" :space-evenly false :halign "fill"
        (label :class "settings-name" :halign "start" :hexpand true :text "Inner gaps")
        (label :class "settings-value" :halign "end" :text "${user-settings.gaps_in}px"))
      (scale :class "settings-scale" :hexpand true
             :value {user-settings.gaps_in} :min 0 :max 40
             :onchange "~/.config/eww/scripts/set-user-setting.py gaps_in {}"))
    (box :class "settings-row" :orientation "vertical" :space-evenly false :spacing 4 :halign "fill" :hexpand true
      (box :orientation "horizontal" :space-evenly false :halign "fill"
        (label :class "settings-name" :halign "start" :hexpand true :text "Outer gaps")
        (label :class "settings-value" :halign "end" :text "${user-settings.gaps_out}px"))
      (scale :class "settings-scale" :hexpand true
             :value {user-settings.gaps_out} :min 0 :max 48
             :onchange "~/.config/eww/scripts/set-user-setting.py gaps_out {}"))
    (box :class "settings-row" :orientation "vertical" :space-evenly false :spacing 4 :halign "fill" :hexpand true
      (box :orientation "horizontal" :space-evenly false :halign "fill"
        (label :class "settings-name" :halign "start" :hexpand true :text "Rounding")
        (label :class "settings-value" :halign "end" :text "${user-settings.rounding}px"))
      (scale :class "settings-scale" :hexpand true
             :value {user-settings.rounding} :min 0 :max 28
             :onchange "~/.config/eww/scripts/set-user-setting.py rounding {}"))
    (box :class "settings-row" :orientation "vertical" :space-evenly false :spacing 4 :halign "fill" :hexpand true
      (box :orientation "horizontal" :space-evenly false :halign "fill"
        (label :class "settings-name" :halign "start" :hexpand true :text "Inactive opacity")
        (label :class "settings-value" :halign "end" :text {user-settings.opacity_label}))
      (scale :class "settings-scale" :hexpand true
             :value {user-settings.opacity_i} :min 40 :max 100
             :onchange "~/.config/eww/scripts/set-user-setting.py opacity_i {}"))
    (box :class "settings-toggles" :orientation "horizontal" :space-evenly true :spacing 8
      (button :class "settings-toggle"
              :onclick "~/.config/eww/scripts/set-user-setting.py accel_profile toggle"
              :tooltip "Pointer acceleration"
        "Accel  ${user-settings.accel_label}")
      (button :class "settings-toggle"
              :onclick "~/.config/eww/scripts/set-user-setting.py animations toggle"
              :tooltip "Window animations"
        "Anim  ${user-settings.animations_label}"))))
