(defwidget music-widget []
  (box :class "music-widget"
       :orientation "horizontal"
       :space-evenly "false"
       :halign "fill"
       :valign "center"
       :hexpand "true"
       :vexpand "true"
    (box :class "song-cover-art-widget"
         :vexpand "false"
         :hexpand "false"
         :valign "center"
         :halign "center"
         :style {current-music-cover != "" ? "background-image: url('" + current-music-cover + "');" : ""}
      (label :class "icon-glyph song-cover-glyph"
             :halign "center"
             :valign "center"
             :hexpand true
             :vexpand true
             :xalign 0.5
             :yalign 0.5
             :text {current-music-cover != "" ? "" : "󰝚"}))
    (box :class "parentbox-widget"
         :orientation "vertical"
         :space-evenly "false"
         :spacing 2
         :hexpand "true"
         :valign "center"
      (label :class "music-title"
             :text {music != "" ? music : "Not playing"}
             :halign "start"
             :truncate "true"
             :limit-width 28)
      (label :class "artist-widget"
             :text {artist != "" ? artist : " "}
             :halign "start"
             :truncate "true"
             :limit-width 28)
      (scale :class "musicbar-widget"
             :hexpand "true"
             :value {current-music-seek != "" ? current-music-seek : "0"}
             :orientation "horizontal"
             :max 101
             :min 0
             :onchange "~/.config/eww/scripts/set-music-seek.sh {}")
      (box :class "music-control-widget"
           :orientation "horizontal"
           :space-evenly "false"
           :spacing 18
           :halign "center"
           :hexpand "true"
        (icon-btn :class "prev-widget"
                  :tooltip "Previous"
                  :onclick "playerctl previous"
                  :icon ""
                  :hexpand false
                  :vexpand false)
        (icon-btn :class "pause-widget"
                  :tooltip "Play / pause"
                  :onclick "playerctl play-pause"
                  :icon {music-status == "Playing" ? "" : ""}
                  :hexpand false
                  :vexpand false)
        (icon-btn :class "next-widget"
                  :tooltip "Next"
                  :onclick "playerctl next"
                  :icon ""
                  :hexpand false
                  :vexpand false)))))
