;;;;; Variables ;;;;;;
(defvar eww "eww -c ~/.config/eww/")
(defvar music-control false)
(defvar user-settings '{"sensitivity":0.5,"sensitivity_i":150,"sensitivity_label":"+0.50","scroll_factor":0.2,"scroll_i":20,"scroll_label":"0.20","gaps_in":8,"gaps_out":18,"rounding":14,"inactive_opacity":0.9,"opacity_i":90,"opacity_label":"90%","animations":true,"animations_label":"On","accel_profile":"flat","accel_label":"Flat"}')
;;;;;;;;;;;;;;;;;;;;;

;;;;; Deflistens ;;;;;
(deflisten music :initial "" "playerctl --follow metadata --format '{{ title }}' || true")
(deflisten artist :initial "" "playerctl --follow metadata --format '{{ artist }}' || true")
(deflisten current-music-cover :initial "" "playerctl --follow metadata --format {{mpris:artUrl}}")
(deflisten music-status :initial "Stopped" "playerctl --follow status || true")
;; Bar feeds. These push instead of polling: the workspace list follows
;; Hyprland's event socket, and the media line drives the equalizer frames.
(deflisten bar-ws :initial '{"active":1,"list":[{"id":1,"label":"1","occupied":false},{"id":2,"label":"2","occupied":false},{"id":3,"label":"3","occupied":false},{"id":4,"label":"4","occupied":false},{"id":5,"label":"5","occupied":false},{"id":6,"label":"6","occupied":false},{"id":7,"label":"7","occupied":false},{"id":8,"label":"8","occupied":false},{"id":9,"label":"9","occupied":false},{"id":10,"label":"0","occupied":false}]}' "~/.config/eww/scripts/bar-workspaces.py")
;;;;;;;;;;;;;;;;;;;;;;

;;;;; Defpolls ;;;;;
(defpoll current-volume :interval "1s" :initial "0" "pactl get-sink-volume @DEFAULT_SINK@ | awk '{print $5}' | sed 's/%//'")
(defpoll current-brightness :interval "1s" :initial "0" "echo $(( $(brightnessctl get) * 100 / $(brightnessctl max) ))")
(defpoll idle :interval "2s" :initial "false" "~/.config/eww/scripts/get-hypridle-status.sh")
(defpoll warm-light :interval "1s" :initial "true" "~/.config/eww/scripts/get-warm-light.sh")
(defpoll current-battery :interval "3s" :initial "0" "~/.config/eww/scripts/get-battery.sh")
(defpoll time-left :interval "15s" :initial "0" "~/.config/eww/scripts/get-time-left.sh")
(defpoll current-memory :interval "10s" :initial "0" "~/.config/eww/scripts/get-memory.sh")
(defpoll current-temperature :interval "10s" :initial "0" "~/.config/eww/scripts/get-temperature.sh")
(defpoll current-cpu :interval "10s" :initial "0" "~/.config/eww/scripts/get-cpu.sh")
(defpoll current-disk :interval "1m" :initial "0" "~/.config/eww/scripts/get-disk.sh")
(defpoll current-disk-detail :interval "1m" :initial "0" "~/.config/eww/scripts/get-disk-detail.sh")
(defpoll current-memory-detail :interval "10s" :initial "0" "~/.config/eww/scripts/get-memory-detail.sh")
(defpoll current-music-seek :interval "1s" "~/.config/eww/scripts/get-music-seek.sh")
(defpoll bluetooth-status :interval "5s" "~/.config/eww/scripts/get-bluetooth-status.sh")
(defpoll wifi-strength :interval "5s" "~/.config/eww/scripts/get-network-strength.sh")
(defpoll volume-icon :interval "1s" "~/.config/eww/scripts/get-volume-icons.sh")
(defpoll panel-clock :interval "1s" :initial '{"hms":"--:--:--","day":"","date":""}' "~/.config/eww/scripts/panel-clock.sh")
(defpoll panel-uptime :interval "15s" :initial '{"hours":0,"mins":0}' "~/.config/eww/scripts/panel-uptime.sh")
(defpoll panel-weather :interval "5m" :initial '{"icon":"☁","temp":"--","temp_c":"--","text":"","city":"Baltimore"}' "~/.config/eww/scripts/panel-weather.py")
;;;;;;;;;;;;;;;;;;;;

;; Widgets ;;
;; This instance draws the control-center overlay and notifications. The
;; wallpaper picker is a second instance in ~/.config/eww-wallpaper, so
;; recolouring these windows cannot reset its scroll position.

(include "widgets/resource-monitor.yuck")
(include "widgets/device-control.yuck")
(include "widgets/notifications.yuck")
(include "widgets/custom-calendar.yuck")
(include "widgets/music-control.yuck")
(include "widgets/dashboard.yuck")
(include "widgets/settings.yuck")
;; Control center ;;
;; Dashboard overlay. Super+C toggles it. The left bar is gone.
(defwindow control-center
  :monitor 0
  :geometry (geometry :x "12px"
                      :y "12px"
                      :width "720px"
                      :height "0%"
                      :anchor "top right")
  :stacking "overlay"
  :exclusive "false"
  ;; The panel takes clicks but never the keyboard, so with follow_mouse=1
  ;; whatever the pointer is over keeps input. "ondemand" would grab the
  ;; keyboard on open and never give it back.
  :focusable "none"
  (control-center-widget))

;; Super+H settings popup (cursor, gaps, rounding, animations).
(defwindow settings
  :monitor 0
  :geometry (geometry :x "0px"
                      :y "0px"
                      :width "420px"
                      :height "0%"
                      :anchor "center")
  :stacking "overlay"
  :exclusive "false"
  :focusable "none"
  (settings-widget))
